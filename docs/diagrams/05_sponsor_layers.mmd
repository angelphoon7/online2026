flowchart LR
    subgraph MANDATORY ["Mandatory — Core Execution"]
        direction TB
        INCH[1inch SwapVM<br/>execution primitive]:::sponsor
        AQUA[Aqua Protocol<br/>shared wallet + settlement]:::sponsor
        ACT[ACTIVENESS_XD<br/>local λ + shared Γ]:::core
    end

    subgraph SECONDARY ["Preferred Secondary"]
        direction TB
        GRAPH[The Graph<br/>live capacity subgraph]:::data
    end

    subgraph STRETCH ["Stretch — After Core Green"]
        direction TB
        WORLD[World ID<br/>human step-up for<br/>exposure relaxation]:::stretch
        LEDGER[Ledger<br/>hardware approval for<br/>exposure-increasing actions]:::stretch
        CHAIN[Chainlink CRE<br/>private runtime<br/>headroom policy]:::stretch
        UNI[Uniswap v4<br/>portability proof<br/>for local λ]:::stretch
    end

    INCH --> ACT
    AQUA --> ACT
    ACT -->|emit ActivenessApplied| GRAPH
    GRAPH -.->|query capacity| SOLVERS[Solvers / UI]:::user

    ACT -.->|step-up gate| WORLD
    ACT -.->|hw approval| LEDGER
    ACT -.->|headroom oracle| CHAIN
    ACT -.->|portability| UNI

    subgraph REMOVAL ["Removal Test"]
        direction TB
        R1["Remove The Graph →<br/>core still works,<br/>discovery is manual"]:::test
        R2["Remove World →<br/>core still works,<br/>no human gate"]:::test
        R3["Remove Ledger →<br/>core still works,<br/>no hw approval"]:::test
        R4["Remove Chainlink →<br/>core still works,<br/>no private headroom"]:::test
        R5["Remove Uniswap →<br/>core still works,<br/>no portability proof"]:::test
    end

    classDef sponsor fill:#312e81,stroke:#818cf8,color:#ffffff,stroke-width:2px;
    classDef core fill:#064e3b,stroke:#34d399,color:#ffffff,stroke-width:2px;
    classDef data fill:#164e63,stroke:#22d3ee,color:#ffffff,stroke-width:2px;
    classDef user fill:#3f3f46,stroke:#d4d4d8,color:#ffffff,stroke-width:2px;
    classDef stretch fill:#1e1b4b,stroke:#6366f1,color:#a5b4fc,stroke-width:1px,stroke-dasharray: 5 5;
    classDef test fill:#1c1917,stroke:#78716c,color:#d6d3d1,stroke-width:1px;
