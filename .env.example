# Tracked template for teammates. Run npm run setup:env to copy it to .env.local
# without replacing existing settings. Next.js does not load .env.example itself.
# Public reading and deterministic diagnosis need no wallet or model credentials.
# CLI writers may require .env and .env.seed; see docs/ARC_TESTNET.md.

# Public deployment selection: keep server and browser on the same registry/domain.
DEPLOYMENT=arc-testnet
NEXT_PUBLIC_DEPLOYMENT=arc-testnet
ARC_CHAIN_ID=5042002
ARC_RPC=https://rpc.testnet.arc.io
USDC_ADDRESS=0x3600000000000000000000000000000000000000
READ_SOURCE=graph
SUBGRAPH_URL=https://api.studio.thegraph.com/query/1760168/reshuffle/v0.1.1
SUBGRAPH_API_KEY=
# Subgraph deployment tooling only; not needed by the hosted app.
SUBGRAPH_DEPLOY_KEY=
# Optional browser RPC override; normally use the deployment manifest's endpoint.
# NEXT_PUBLIC_RPC_URL=https://rpc.testnet.arc.io

# Hosted application storage. Use a persistent Redis REST database, e.g. Upstash.
# Local development may use STORAGE_BACKEND=file without these credentials.
# Production Agent APIs require Redis even with persistent file evidence storage.
STORAGE_BACKEND=file
STORAGE_NAMESPACE=reshuffle-arc-testnet
REDIS_REST_URL=
REDIS_REST_TOKEN=
# Provider-injected alternatives are also recognized as complete pairs:
# UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN, or
# KV_REST_API_URL + KV_REST_API_TOKEN (Vercel Marketplace).
# Do not mix pairs. On Vercel set STORAGE_BACKEND=redis, not the local file default.
# For a single backend with an actual persistent disk only; never serverless:
ALLOW_PERSISTENT_FILE_STORAGE=false
# STORAGE_DIRECTORY=/mounted-persistent-volume/reshuffle

# Run npm run judge:setup to generate private local access settings.
JUDGE_CONTROLS_ENABLED=false
JUDGE_ACCESS_CODE=
# Comma-separated exact intent hashes judges may change. Replacements inherit scope.
JUDGE_ALLOWED_INTENT_HASHES=
DEMO_TICKETS_ENABLED=false
# Testnet signing only. Supply through the host's secret environment configuration.
PRIVATE_KEY=
DEPLOYER_ADDRESS=
DEMO_ISSUER_PRIVATE_KEY=
SEED_B_PRIVATE_KEY=
SEED_C_PRIVATE_KEY=

# Optional model narration; deterministic diagnosis works without a model key.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5
AGENT_ASK_TIMEOUT_MS=60000
AGENT_DIAGNOSE_TIMEOUT_MS=30000
# auto uses memory locally without Redis, and requires Redis in production.
AGENT_RATE_LIMIT_STORE=auto
# auto uses Vercel's header on Vercel, the trusted proxy when enabled below,
# or one shared unidentified bucket in local development.
AGENT_IP_SOURCE=auto
# Legacy controlled-proxy alias. Vercel auto selection uses its own platform header.
AGENT_TRUST_PROXY=false
BUDGET_CAP_USDC=100

# Event dates are built into the browser; new dates need new signed intents.
NEXT_PUBLIC_SESSION_0_START=2026-09-19T20:00:00+08:00
NEXT_PUBLIC_SESSION_1_START=2026-09-20T20:00:00+08:00

# Separate mainnet tooling only. Leave empty for this testnet app.
# Mainnet parameters, admin decisions and deployment remain release gates.
ARC_MAINNET_RPC=
ARC_MAINNET_PRIVATE_KEY=
