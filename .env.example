# Arc Testnet: https://docs.arc.io/arc/references/rpc-endpoints
# Selects deployments/<network>.json, the single source of addresses and start blocks.
DEPLOYMENT=arc-testnet
ARC_RPC=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
# Forge script execution budget, not a per-transaction gas cap or measurement.
ARC_SCRIPT_GAS_LIMIT=30000000
USDC_ADDRESS=0x3600000000000000000000000000000000000000
ARC_EXPLORER_URL=https://testnet.arcscan.app
ARC_FAUCET_URL=https://faucet.circle.com
# Local testnet deployer only. Never use NEXT_PUBLIC_ for a private key.
PRIVATE_KEY=
# Free demo ticket button: enabled automatically during local development.
# For a hosted testnet demo, set true and use a registered, funded issuer key.
DEMO_TICKETS_ENABLED=
# Optional separate issuer credential; falls back to PRIVATE_KEY.
DEMO_ISSUER_PRIVATE_KEY=
DEPLOYER_ADDRESS=0x4a599d033E1295E93bbFB5feA17aB44b2CbAD9fD
# Subgraph Studio. Deploy key publishes; API key queries. Never commit real values.
SUBGRAPH_DEPLOY_KEY=
SUBGRAPH_URL=
SUBGRAPH_API_KEY=
# Which mechanism reconstructs the market and the solver's pool: 'graph' or 'rpc'.
# Defaults to 'graph' when SUBGRAPH_URL is set, otherwise 'rpc'. Local Anvil must use 'rpc',
# because Studio cannot index it. Server-side only - reads never run in the browser.
READ_SOURCE=
# Judge controls (Apply budget / Revoke participant). Real on-chain transactions signed with
# the seeded participants' keys, so they only work where those keys exist. Enabled
# automatically during local development; set true for a hosted judged demo.
JUDGE_CONTROLS_ENABLED=
# Seeded demo participant keys live in .env.seed as SEED_A_PRIVATE_KEY, SEED_B_PRIVATE_KEY, ...
# Next does not load that file, so server/judge-budget.ts reads it directly. Never commit it.

# The agent (plan step 7). Only /api/agent/ask needs a key: GET /api/agent/diagnose/<hash>
# returns the full evidence and the deterministic sentence with no key at all, which is how a
# judge can check the answers. Without a key /api/agent/ask returns that same sentence.
ANTHROPIC_API_KEY=
# Narration model. The deterministic engine decides everything; this only writes the sentences.
AGENT_MODEL=claude-sonnet-5
# Ceiling the BUDGET relaxation raises maxNetPay to when asking "would more money settle this".
BUDGET_CAP_USDC=100

# Future mainnet deployment only; public parameters live in config/arc-mainnet.json.
# Leave blank until official mainnet parameters are confirmed. Never reuse demo keys.
ARC_MAINNET_RPC=
ARC_MAINNET_PRIVATE_KEY=

# Contract addresses, chain id and start block are NOT environment variables.
# lib/deployment.ts reads deployments/<network>.json, selected by NEXT_PUBLIC_DEPLOYMENT.
NEXT_PUBLIC_DEPLOYMENT=arc-testnet
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.arc.io

# Labelled demo schedule, Malaysia time (UTC+8). New intents expire 8 hours earlier.
# Public values are embedded at build time; rebuild after changing them.
NEXT_PUBLIC_SESSION_0_START=2026-09-19T20:00:00+08:00
NEXT_PUBLIC_SESSION_1_START=2026-09-20T20:00:00+08:00
